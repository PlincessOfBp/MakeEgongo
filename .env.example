# 로컬 자동 창작용 환경변수 샘플 (.env.example)
# 이 파일은 커밋됩니다. 실제 키는 절대 넣지 마세요.
# 실제 키는 'agent/notes.local.md' 안내를 참고해 .env 파일로 복사해서 사용합니다.

# Google Gemini API 키 (Google AI Studio 에서 발급)
# GitHub 배포용으로는 이 키를 Repository Settings > Secrets and variables > Actions 에
# 이름 'GEMINI_API_KEY' 로 등록하세요. (이 파일에 넣지 마세요)
GEMINI_API_KEY=

# 사용할 무료 모델 풀 (콤마 구분). 앞의 모델의 토큰/할당량이 다 차면
# 자동으로 다음 모델로 전환됩니다 (2.5 계열 제외, 무료 Flash 계열 위주).
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# 캐릭터 외관 이미지 생성용 Pollinations.ai API 키 (선택)
# enter.pollinations.ai > API keys 에서 sk_ 로 시작하는 Secret key를 발급받아 등록합니다.
# GitHub 배포용으로는 Repository Settings > Secrets and variables > Actions 에
# 이름 'POLLIN_API_KEY' 로 등록하세요. (이 파일에 넣지 마세요)
# 사용할 이미지 생성 모델 풀 (콤마 구분, 기본 sana) → 이름 'POLLIN_MODELS' 의 Actions variables 로 등록.
POLLIN_API_KEY=
POLLIN_MODELS=sana

# 캐릭터 외관 이미지 생성용 PixAI API(애니 특화, 선택)
# platform.pixai.art 에서 발급한 Bearer 토큰을 등록합니다. (멤버십 즉시 발급 / api@withpixai.art 이메일 신청은
# 심사 후 영업일 최대 5일 내 발급 — 생성 결과는 공개 갤러리에 안 올라가는 비공개 API 태스크)
# GitHub 배포용으로는 Actions Secret 'PIXAI_API_KEY' 로 등록하세요.
# - PIXAI_MODEL_VERSION: 사용할 PixAI 모델 버전 id. 모델 페이지에서 버전 클릭 후 URL 마지막 경로를 복사.
#   (예: Tsubaki.3 → https://pixai.art/model/<id>-<slug>/<modelVersionId> 의 <modelVersionId>)
# - PIXAI_MODE: Tsubaki 전용 품질 lite/standard/pro/ultra (기본 standard)
# - PIXAI_STYLE: named style 프리셋 (선택)
# 모델 풀 첫 항목을 'pixai' 로 두면 PixAI 우선, 실패 시 flux/sana 로 자동 폴백.
PIXAI_API_KEY=
PIXAI_MODEL_VERSION=
PIXAI_MODE=standard
PIXAI_STYLE=